{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "VRCX-Pro",
    "version": "3.0.0",
    "identifier": "app.vrcx",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:9000",
        "beforeBuildCommand": "npm run build:html",
        "frontendDist": "../build/html"
    },
    "app": {
        "windows": [
            {
                "title": "VRCX-Pro",
                "width": 1600,
                "height": 900,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installerIcon": "icons/icon.ico",
                "installMode": "perMachine"
            }
        },
        "resources": {
            "../build/Sidecar/*": "sidecar/",
            "target/release/WebView2Loader.dll": "WebView2Loader.dll"
        }
    }
}
