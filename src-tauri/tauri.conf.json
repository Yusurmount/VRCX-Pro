{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCX-Pro",
  "version": "3.7.2-it",
  "identifier": "app.vrcx",
  "build": {
    "beforeDevCommand": "npm run build:tauri-backend:dev && npm run dev:auto",
    "devUrl": "http://localhost:9000",
    "beforeBuildCommand": "npm run prod:auto && npm run build:tauri-backend",
    "frontendDist": "../build/html"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VRCX-Pro",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../build/TauriBackend": "dotnet-runtime"
    },
    "windows": {
      "nsis": {
        "template": "templates/installer.nsi",
        "compression": "bzip2",
        "installMode": "perMachine",
        "languages": [
          "SimpChinese"
        ],
        "installerIcon": "../images/VRCX.ico",
        "uninstallerIcon": "../images/VRCX.ico"
      }
    },
    "icon": [
      "../images/VRCX.png",
      "../images/VRCX.ico"
    ]
  }
}
